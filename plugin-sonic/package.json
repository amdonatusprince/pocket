{
    "name": "@pocketfinance/sonic-plugin",
    "version": "0.1.0",
    "description": "AI-powered DeFi interactions for the Sonic blockchain ecosystem",
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "license": "MIT",
    "author": "amdonatusprince",
    "repository": {
        "type": "git",
        "url": "https://github.com/amdonatusprince/pocket/tree/main/plugin-sonic"
    },
    "keywords": [
        "defi",
        "sonic",
        "blockchain",
        "ai",
        "eliza",
        "web3",
        "crypto",
        "pocketfi",
        "smart-contracts"
    ],
    "dependencies": {
        "@elizaos/core": "0.1.9",
        "@lifi/data-types": "5.15.5",
        "@lifi/sdk": "3.4.1",
        "@lifi/types": "16.3.0",
        "@openocean.finance/openocean-sdk": "^1.7.32",
        "@openzeppelin/contracts": "^5.2.0",
        "@types/node": "^22.10.5",
        "@web3-name-sdk/core": "^0.3.2",
        "solc": "^0.8.28",
        "viem": "2.21.53",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "tsup": "8.3.5",
        "typescript": "^5.7.3",
        "vitest": "^3.0.5"
    },
    "scripts": {
        "build": "tsup --format esm --dts",
        "dev": "tsup --format esm --dts --watch",
        "test": "vitest run",
        "clean": "rm -rf dist",
        "lint": "biome lint .",
        "lint:fix": "biome check --apply .",
        "format": "biome format .",
        "format:fix": "biome format --write ."
    },
    "peerDependencies": {
        "whatwg-url": "7.1.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "src/contracts",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=16.0.0"
    }
}
